<%- layout("layouts/boilerplate") %>

<body>
  <div class="page-container">
    <h2 class="page-title">All Users</h2>

    <div class="user-cards-container">
      <% if (users.length > 0) { %>
        <% users.forEach(user => { %>
          <div class="user-card">
            <div class="user-card-body">
              <h4 class="user-name"><%= user.username || user.name %></h4>
              <p class="user-email"><%= user.email %></p>
              <small class="user-joined">Joined: <%= user.joinedAt ? user.joinedAt.toDateString() : "N/A" %></small>
              <form method="POST" action="/admin/users/<%= user._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this user?');">
                <button class="btn btn-danger btn-sm">Delete</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="no-users">No users found.</p>
      <% } %>
    </div>
  </div>
</body>
