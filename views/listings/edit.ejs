<% layout("layouts/boilerplate") %>

<body>
  <div class="container-listing">
    <h3>Edit Listing</h3>

    <% if (locals.errors) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control" id="title" required>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" id="description" rows="4" required><%= listing.description %></textarea>
      </div>

      <!-- Image URL -->
       <% if (listing.image && listing.image.url) { %>
        <img src="<%= listing.image.url %>" alt="Current Image" style="max-width:200px;">
      <% } %>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input type="file" id="image" name="listing[image]" placeholder="Paste image URL" class="form-control">
      </div>

      <!-- Price & Category -->
      <div class="row g-3 align-items-end mb-3">
        <div class="col-md-4">
          <label for="price" class="form-label">Price</label>
          <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" class="form-control" required>
        </div>

        <div class="col-md-8">
          <label for="category" class="form-label">Category</label>
          <div class="btn-group w-100">
            <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="categoryBtn">
              <%= listing.category.charAt(0).toUpperCase() + listing.category.slice(1) || "Select category" %>
            </button>
            <ul class="dropdown-menu w-100" style="max-height: 200px; overflow-y: auto;">
              <% const categories = ['mountains', 'cozy beach', 'resorts', 'hotels', 'forest', 'castle', 'farms', 'cities', 'camping', 'deserts', 'island']; %>
              <% categories.forEach(cat => { %>
                <li>
                  <a class="dropdown-item" href="#" onclick="selectCategory('<%= cat %>')">
                    <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
          <input type="hidden" name="listing[category]" id="categoryInput" value="<%= listing.category %>">
        </div>
      </div>

      <!-- Country & Location -->
      <div class="row mb-3">
        <div class="col-4">
          <label for="country" class="form-label">Country</label>
          <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" class="form-control" required>
        </div>
        <div class="col-8">
          <label for="location" class="form-label">Location</label>
          <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" class="form-control" required>
        </div>
      </div>

      <button type="submit" class="btn btn-dark">Update Listing</button>
    </form>
  </div>
</body>
