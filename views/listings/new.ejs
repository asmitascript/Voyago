<% layout("layouts/boilerplate") %>

<body>
  <div class="container-listing">
    <h3>Create a New Listing</h3>

    <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">

      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" placeholder="Add a title" class="form-control" required>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" placeholder="Type a description" class="form-control" required></textarea>
      </div>

      <!-- Image -->
      <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input type="file" id="image" name="listing[image]" class="form-control">
      </div>

      <!-- Price & Category -->
      <div class="row g-3 align-items-end mb-3">
        <div class="col-md-4">
          <label for="price" class="form-label">Price</label>
          <input type="number" id="price" name="listing[price]" placeholder="Enter price" class="form-control" required>
        </div>

        <div class="col-md-8">
          <label for="category" class="form-label" style="margin-bottom: 0%;">Category</label>
          <div class="btn-group w-100">
            <button type="button" class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="categoryBtn">
              Select category
            </button>
            <ul class="dropdown-menu w-100" style="max-height: 200px; overflow-y: auto;">
              <% const categories = ['mountains', 'cozy beach', 'resorts', 'hotels', 'forest', 'castle', 'farms', 'cities', 'camping', 'island']; %>
              <% categories.forEach(cat => { %>
                <li>
                  <a class="dropdown-item" href="#" onclick="selectCategory('<%= cat %>')">
                    <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
          <input type="hidden" name="listing[category]" id="categoryInput">
        </div>
      </div>

      <!-- Country & Location -->
      <div class="row mb-3">
        <div class="col-4">
          <label for="country" class="form-label">Country</label>
          <input type="text" placeholder="India" name="listing[country]" class="form-control" required>
        </div>
        <div class="col-8">
          <label for="location" class="form-label">Location</label>
          <input type="text" placeholder="Kolkata, WestBengal" name="listing[location]" class="form-control" required>
        </div>
      </div>

      <button type="submit" class="btn btn-dark">Add Listing</button>
    </form>
  </div>
</body>
