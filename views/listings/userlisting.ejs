<%- layout("layouts/boilerplate") %>

<div class="container my-5">
  <h2 class="mb-4 text-center">My Listings</h2>

  <% if (listings.length === 0) { %>
    <div class="alert alert-info text-center" style="background-color: #ffabb4; color: #dc3545;">
      You haven't created any listings yet.
      <br>
      <a href="/listings/new" class="btn btn-primary mt-3 my-create">Showcase One Now</a>
    </div>
  <% } else { %>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-2 g-4">
      <% listings.forEach(listing => { %>
        <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card">
                    <img src="<%= listing.image.url%>" class="card-img-top" alt="Image of <%= listing.title %>" style="height: 20rem;">
                    <div class="card-img-overlay">Voyago</div>
                    <div class="card-body">
                        <p class="card-text">
                        <b><%= listing.title%></b>
                        </br>
                       &#8377; <%= listing.price.toLocaleString("en-IN")%> /night
                        </p>
                    </div>
                </div>
            </a>
      <% }) %>
    </div>
  <% } %>
</div>
