<% layout("layouts/boilerplate")%>
<link rel="stylesheet" href="/style/style.css">
<body>
    <div id="carouselExample" class="carousel slide" data-bs-ride="false">
  <div class="carousel-inner">

    <!-- Slide 1 -->
    <div class="carousel-item active">
      <div class="filters">
        <div class="filter" data-category="mountains">
          <div><i class="fa-solid fa-mountain-sun"></i></div>
          <p>Mountains</p>
        </div>
        <div class="filter" data-category="cozy beach">
          <div><i class="fa-solid fa-umbrella-beach"></i></div>
          <p>Cozy Beach</p>
        </div>
        <div class="filter" data-category="resorts">
          <div><i class="fa-solid fa-house-chimney"></i></div>
          <p>Resorts</p>
        </div>
        <div class="filter" data-category="hotels">
          <div><i class="fa-solid fa-bed"></i></div>
          <p>Hotels</p>
        </div>
        <div class="filter" data-category="forest">
          <div><i class="fa-solid fa-tree"></i></div>
          <p>Forest</p>
        </div>
        <div class="filter" data-category="castle">
          <div><i class="fa-brands fa-fort-awesome"></i></div>
          <p>Castles</p>
        </div>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-item">
      <div class="filters">
        <div class="filter" data-category="farms">
          <div><i class="fa-solid fa-cow"></i></div>
          <p>Farms</p>
        </div>
        <div class="filter" data-category="cities">
          <div><i class="fa-solid fa-city"></i></div>
          <p>Cities</p>
        </div>
        <div class="filter" data-category="camping">
          <div><i class="fa-solid fa-tent"></i></div>
          <p>Camping</p>
        </div>
        <div class="filter" data-category="desert">
          <div><i class="fa-solid fa-sun"></i></div>
          <p>Desert</p>
        </div>
        <div class="filter" data-category="island">
          <div><i class="fa-solid fa-water"></i></div>
          <p>Island</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Manual Navigation Buttons -->
  <button class="carousel-control-prev slide-le" type="button" data-bs-target="#carouselExample" data-bs-slide="prev" style="background-color: black;">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>

  <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next" style="background-color: black;">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-2 mt-3">
        <% for(let listing of allListings) { %>
            <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="card">
                    <img src="<%= listing.image.url%>" class="card-img-top" alt="Image of <%= listing.title %>" style="height: 20rem;">
                    <div class="card-img-overlay">Voyago</div>
                    <div class="card-body">
                        <p class="card-text">
                        <b><%= listing.title%></b>
                        </br>
                       &#8377; <%= listing.price.toLocaleString("en-IN")%> /night
                        </p>
                    </div>
                </div>
            </a>
        <%}%>
    </div>
</body>
</html>