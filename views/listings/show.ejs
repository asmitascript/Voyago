<%- layout("layouts/boilerplate") %>
<link href="https://unpkg.com/maplibre-gl@2.4.0/dist/maplibre-gl.css" rel="stylesheet" />
<body>
  <div class="container mt-4 show">
    <div class="row">
      <!-- Left Column: Listing Details -->
      <div class="col-md-7 col-lg-7 pe-4">
        <h3><%= listing.title %></h3>

        <div class="card">
          <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="Photo of <%= listing.title %>">
          <div class="card-body">
            <p class="card-text">
              <i>Hosted by <b><%= listing.owner.username %></b></i><br>
              <%= listing.description %><br>
              ₹<%= listing.price.toLocaleString("en-IN") %> /night<br>
              <%= listing.location %><br>
              <%= listing.country %><br>
              <strong>Category: </strong><%= listing.category %>
            </p>
          </div>
        </div>

        <!-- Edit/Delete Listing for Owner -->
        <% if (currUser) { %>
          <div class="mt-3 d-flex flex-column gap-2">
            <% if (currUser._id.toString() === listing.owner._id.toString()) { %>
            <form method="get" action="/listings/<%= listing._id %>/edit">
              <button class="btn btn-dark w-100">Edit</button>
            </form>
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
              <button class="btn btn-danger w-100">Delete</button>
            </form>
            <% } else if (currUser.role === 'admin') { %>
              <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-danger w-100">Delete</button>
              </form>
            <% } %>
          </div>
        <% } %>
        
      </div>

      <!-- Right Column: Reviews -->
      <div class="col-md-5 col-lg-5 ps-4">
        <h5>All Reviews</h5>
        <div class="d-flex flex-wrap gap-3 overflow-auto" style="max-height: 50vh;">
          <% if (listing.reviews.length === 0) { %>
            <p>No reviews yet.</p>
          <% } %>

          <% for (let review of listing.reviews) { %>
            <div class="card" style="width: 16rem;">
              <div class="card-body border border-dark rounded">
                <h6><%= review.author.username %></h6>
                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                <p class="card-text"><%= review.comment %></p>
                <% if (currUser && (currUser._id.toString() === review.author._id.toString() || currUser.role === 'admin')) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-danger btn-sm">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
  <hr>
    <h4>Where you'll be</h4>
    <br>
    <div id="map"></div>
    <br>
  <script src="https://unpkg.com/maplibre-gl@2.4.0/dist/maplibre-gl.js"></script>
  <script>
    const GEOAPIFY_API_KEY = "<%= GEOAPIFY_KEY %>";
    const long = "<%= listing.geometry.coordinates[0] %>";
    const lat = "<%= listing.geometry.coordinates[1] %>";
  </script>
  <script src="/js/map.js"></script>
</body>
</html>
